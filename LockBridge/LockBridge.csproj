<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- WinFsp managed Api.CheckVersion uses assembly path/version metadata.
         Single-file bundling leaves Assembly.Location empty, triggering
         ArgumentException (path) before the filesystem can be mounted. -->
    <PublishSingleFile>false</PublishSingleFile>
    <AssemblyName>NASMountLockBridge</AssemblyName>
    <Version>1.3.98</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="winfsp.net" />
    <PackageReference Include="FluentFTP" />
    <PackageReference Include="SSH.NET" />
    <Compile Include="..\Core.cs" Link="Shared\Core.cs"/>
    <Compile Include="..\MountPresentation.cs" Link="Shared\MountPresentation.cs"/>
    <Compile Include="..\CooperativeLocks.cs" Link="Shared\CooperativeLocks.cs"/>
    <Compile Include="..\OfficeUseMarker.cs" Link="Shared\OfficeUseMarker.cs"/>
    <Compile Include="..\OfficeMarkerWorkbook.cs" Link="Shared\OfficeMarkerWorkbook.cs"/>
  </ItemGroup>
</Project>
