<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>FileHubAIO</AssemblyName>
    <Product>FileHub AIO</Product>
    <Title>FileHub AIO for Windows</Title>
    <Version>1.3.151</Version>
    <RuntimeFrameworkVersion>10.0.15</RuntimeFrameworkVersion>
    <ApplicationIcon>assets\NASMountBadge.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="assets\NASMountBadge.ico" Link="tools\NASMountBadge.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="assets\GoogleDriveMark.png" Link="tools\GoogleDriveMark.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="assets\TeraBoxMark.png" Link="tools\TeraBoxMark.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Publisher config only. When provided, Google login becomes a
         one-button Chrome OAuth flow with no per-user API fields.
         Never ship example/placeholder OAuth credentials as production. -->
    <Content Include="tools\google-oauth-desktop.json"
             Condition="Exists('tools\google-oauth-desktop.json')"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Compile Remove="LockBridge\**\*.cs" />
    <Compile Remove="tests\**\*.cs" />
    <Compile Remove="dist\**\*.cs" />
    <PackageReference Include="FluentFTP" />
    <PackageReference Include="Microsoft.Web.WebView2" />
    <PackageReference Include="SSH.NET" />
    <EmbeddedResource Include="README_COMPONENTS_1378.md" LogicalName="NASMount.ComponentsManifest" />
    <Content Include="README_COMPONENTS_1378.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
