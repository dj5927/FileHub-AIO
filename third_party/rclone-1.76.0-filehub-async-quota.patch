+// statfsAsyncAbout returns the last known quota without waiting for the
+// remote API. Explorer frequently calls volume info while traversing files;
+// an uncached synchronous About call can stall every Explorer window.
+// The FileHub launcher opts into this path for its Google-specific engine.
+func (vfs *VFS) statfsAsyncAbout(about func(context.Context) (*fs.Usage, error)) (total, used, free int64) {
+	vfs.usageMu.Lock()
+	// Let the initial mount/root enumeration finish before issuing About.
+	// This separate Google API request can stall for 30 seconds or more.
+	if vfs.usageRefreshAfter.IsZero() { vfs.usageRefreshAfter = time.Now().Add(15 * time.Second) }
+	if !vfs.usageRefreshing && !time.Now().Before(vfs.usageRefreshAfter) {
+		vfs.usageRefreshing = true
+		vfs.usageRefreshAfter = time.Now().Add(30 * time.Second)
+		go func() {
+			ctx, cancel := context.WithTimeout(vfs.ctx, 12*time.Second)
+			defer cancel()
+			quota, err := about(ctx)
+			vfs.usageMu.Lock()
+			defer vfs.usageMu.Unlock()
+			vfs.usageRefreshing = false
+			if err != nil || quota == nil || quota.Total == nil || quota.Free == nil || quota.Used == nil {
+				vfs.usageRefreshAfter = time.Now().Add(30 * time.Second)
+				fs.Debugf(vfs.f, "Nonblocking quota refresh deferred (previous quota retained)")
+				return
+			}
+			vfs.usage = quota
+			vfs.usageTime = time.Now()
+			vfs.usageRefreshAfter = time.Now().Add(30 * time.Minute)
+			fs.Infof(vfs.f, "FILEHUB_QUOTA_CACHED total=%d used=%d free=%d",
+				*quota.Total, *quota.Used, *quota.Free)
+		}()
+	}
+	total, used, free = -1, -1, -1
+	if quota := vfs.usage; quota != nil {
+		if quota.Total != nil {
+			total = *quota.Total
+		}
+		if quota.Used != nil {
+			used = *quota.Used
+		}
+		if quota.Free != nil {
+			free = *quota.Free
+		}
+	}
+	vfs.usageMu.Unlock()
+	if int64(vfs.Opt.DiskSpaceTotalSize) >= 0 {
+		total = int64(vfs.Opt.DiskSpaceTotalSize)
+	}
+	return fillInMissingSizes(total, used, free, unknownFreeBytes)
+}
