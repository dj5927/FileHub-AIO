<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- WinFsp managed Api.CheckVersion uses assembly path/version metadata.
         Single-file bundling leaves Assembly.Location empty, triggering
         ArgumentException (path) before the filesystem can be mounted. -->
    <PublishSingleFile>false</PublishSingleFile>
    <AssemblyName>NASMountLockBridge</AssemblyName>
    <Version>1.3.146</Version>
    <RuntimeFrameworkVersion>10.0.15</RuntimeFrameworkVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="winfsp.net" />
    <!-- 2.2 managed binding requires native driver 2.2+. Retain the exact
         2.1 binding for existing 2.1 installations until users upgrade. -->
    <PackageDownload Include="winfsp.net" Version="[2.1.25156]" />
    <Content Include="$(NuGetPackageRoot)winfsp.net\2.1.25156\lib\netstandard2.0\winfsp-msil.dll"
             Link="winfsp-legacy\winfsp-msil.dll"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <PackageReference Include="FluentFTP" />
    <PackageReference Include="SSH.NET" />
    <Compile Include="..\Core.cs" Link="Shared\Core.cs"/>
    <Compile Include="..\LocalCachePolicy.cs" Link="Shared\LocalCachePolicy.cs"/>
    <Compile Include="..\MountPresentation.cs" Link="Shared\MountPresentation.cs"/>
    <Compile Include="..\CooperativeLocks.cs" Link="Shared\CooperativeLocks.cs"/>
    <Compile Include="..\WebDavTlsPolicy.cs" Link="Shared\WebDavTlsPolicy.cs"/>
    <Compile Include="..\OfficeUseMarker.cs" Link="Shared\OfficeUseMarker.cs"/>
    <Compile Include="..\OfficeMarkerWorkbook.cs" Link="Shared\OfficeMarkerWorkbook.cs"/>
    <Compile Include="..\GoogleDirectApiClient.cs" Link="Shared\GoogleDirectApiClient.cs"/>
    <Compile Include="..\GoogleDirectOAuthSession.cs" Link="Shared\GoogleDirectOAuthSession.cs"/>
    <Compile Include="..\GoogleDirectCredentialStore.cs" Link="Shared\GoogleDirectCredentialStore.cs"/>
    <Compile Include="..\GoogleOAuthClientFile.cs" Link="Shared\GoogleOAuthClientFile.cs"/>
  </ItemGroup>
</Project>
